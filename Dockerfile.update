# Update a verified v5 runtime with isolated v6 classifier environments.
# Pass an immutable local image ID/digest. Changes to existing environments require Dockerfile.
# For a local image ID, use DOCKER_BUILDKIT=0 so no registry lookup is attempted.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG SOURCE_COMMIT
ARG SOURCE_SHA256

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /opt/oncotracer

# Ownership must be fixed in the original layers; updating their final contents
# cannot make an older image importable with default rootless UID mappings.
RUN python -B -c "from pathlib import Path; copies=[line for line in Path('/opt/oncotracer/Dockerfile').read_text().splitlines() if line.startswith('COPY --from=')]; assert copies and all('--chown=0:0' in line.split() for line in copies), 'Base image predates rootless ownership normalization; use the full Dockerfile'"

COPY environments/ /tmp/oncotracer-update-environments/
RUN python -B -c "from pathlib import Path; import hashlib; digest=lambda p:{str(f.relative_to(p)):hashlib.sha256(f.read_bytes()).hexdigest() for f in p.rglob('*') if f.is_file()}; old=digest(Path('/opt/oncotracer/environments')); new=digest(Path('/tmp/oncotracer-update-environments')); assert all(new.get(k)==v for k,v in old.items()) and set(new)-set(old) <= {'native-rockfish.yml', 'native-marlin.yml', 'native-sturgeon-deps.yml'}, 'Scientific environment definitions changed; use the full Dockerfile'"

# Keep classifier dependencies separate from the validated CNA/variant environments.
RUN CONDA_OVERRIDE_CUDA=11.8 conda env create --prefix /opt/oncotracer-envs/marlin --file /tmp/oncotracer-update-environments/native-marlin.yml \
    && conda clean -afy
RUN conda env create --prefix /opt/oncotracer-envs/sturgeon-deps --file /tmp/oncotracer-update-environments/native-sturgeon-deps.yml \
    && conda clean -afy

COPY . /opt/oncotracer/

RUN CC=/opt/conda/bin/x86_64-conda-linux-gnu-gcc \
    CXX=/opt/conda/bin/x86_64-conda-linux-gnu-g++ \
    /opt/conda/bin/python -B -m oncotracer_cli.cli prepare-rockfish \
    --directory /opt/oncotracer-rockfish --python /opt/conda/bin/python --cuda \
    && chmod 0755 /opt/oncotracer-rockfish/source
ENV ONCOTRACER_ROCKFISH_PREFIX=/opt/oncotracer-rockfish

# MARLIN model: CC-BY-4.0; its MIT adapter and attribution ship with this image.
# Dorado and licensed Sturgeon are prepared only in each user's private cache.
RUN /opt/conda/bin/python -B -c "from oncotracer_cli.managed_resources import prepare_marlin; prepare_marlin('/opt/oncotracer-resources/marlin')" \
    && cp bin/scripts/MARLIN-MIT-LICENSE.txt docs/licenses/MARLIN-model-attribution.txt /opt/oncotracer-resources/marlin/ \
    && RETICULATE_PYTHON=/opt/oncotracer-envs/marlin/bin/python RETICULATE_USE_MANAGED_VENV=no CUDA_VISIBLE_DEVICES=-1 \
       /opt/oncotracer-envs/marlin/bin/Rscript --vanilla bin/scripts/native_marlin_preflight.R --python /opt/oncotracer-envs/marlin/bin/python \
    && /opt/oncotracer-envs/marlin/bin/modkit --version \
    && /opt/oncotracer-envs/sturgeon-deps/bin/python -c "import numpy,pandas,onnxruntime,pysam,modbampy"
# Keep build-time Nextflow caches out of the writable runtime home, including
# caches inherited from earlier incremental images used as the base.
RUN test -n "${SOURCE_COMMIT}" && test -n "${SOURCE_SHA256}" \
    && PATH="${ONCOTRACER_VARIANTS_PREFIX}/bin:/opt/micromamba/envs/clairs-to/bin:${PATH}" /opt/conda/bin/python -B -m unittest tests.test_variant_work tests.test_glimpse_parallel tests.test_glimpse_task_resources tests.test_glimpse_preflight_parallel tests.test_variant_postcalling tests.test_glimpse_joint tests.test_glimpse_resume tests.test_optional_cohort tests.test_glimpse_storage tests.test_dynamic_resources tests.test_quilt_parallel tests.test_gistic_eligibility tests.test_project_resume tests.test_podman_backend tests.test_glimpse_ffpe_report tests.test_cna_sensitivity tests.test_broad_cna tests.test_native_methylation -q \
    && "${ONCOTRACER_QDNASEQ_PREFIX}/bin/Rscript" --vanilla tests/test_cna_coverage.R \
    && "${ONCOTRACER_CLASSIFIER_PREFIX}/bin/python" -B -m unittest tests.test_native_classifier.NativeClassifierTests.test_required_gistic_with_one_eligible_sample_finishes_reports_and_preserves_qc -q \
    && build_dir="$(mktemp -d /tmp/oncotracer-build.XXXXXXXX)" \
    && python -B scripts/build_native_binary.py --root /opt/oncotracer \
       --output "${build_dir}/oncotracer" --source-commit "${SOURCE_COMMIT}" --source-sha256 "${SOURCE_SHA256}" \
    && install -m 0755 "${build_dir}/oncotracer" /usr/local/bin/oncotracer \
    && rm "${build_dir}/oncotracer" && rmdir "${build_dir}" \
    && oncotracer --version \
    && oncotracer provenance --json \
    && NXF_HOME=/tmp/nextflow-build nextflow -version \
    && rm -rf /tmp/nextflow-build /tmp/nextflow

LABEL org.opencontainers.image.version="6.2.0" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.source.sha256="${SOURCE_SHA256}"

ENTRYPOINT ["oncotracer"]
CMD ["--help"]

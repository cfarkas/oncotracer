# Application-only update of an already verified scientific runtime.
# Pass an immutable local image ID/digest. Environment changes require Dockerfile.
# For a local image ID, use DOCKER_BUILDKIT=0 so no registry lookup is attempted.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG SOURCE_COMMIT
ARG SOURCE_SHA256

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /opt/oncotracer

COPY environments/ /tmp/oncotracer-update-environments/
RUN python -B -c "from pathlib import Path; import hashlib; digest=lambda p:{str(f.relative_to(p)):hashlib.sha256(f.read_bytes()).hexdigest() for f in p.rglob('*') if f.is_file()}; assert digest(Path('/opt/oncotracer/environments')) == digest(Path('/tmp/oncotracer-update-environments')), 'Scientific environment definitions changed; use the full Dockerfile'"

COPY . /opt/oncotracer/
RUN test -n "${SOURCE_COMMIT}" && test -n "${SOURCE_SHA256}" \
    && PATH="${ONCOTRACER_VARIANTS_PREFIX}/bin:/opt/micromamba/envs/clairs-to/bin:${PATH}" /opt/conda/bin/python -B -m unittest tests.test_variant_work tests.test_glimpse_parallel tests.test_glimpse_preflight_parallel tests.test_variant_postcalling tests.test_glimpse_joint tests.test_glimpse_resume tests.test_optional_cohort tests.test_glimpse_storage tests.test_dynamic_resources tests.test_quilt_parallel tests.test_gistic_eligibility tests.test_project_resume tests.test_podman_backend tests.test_glimpse_ffpe_report -q \
    && "${ONCOTRACER_CLASSIFIER_PREFIX}/bin/python" -B -m unittest tests.test_native_classifier.NativeClassifierTests.test_required_gistic_with_one_eligible_sample_finishes_reports_and_preserves_qc -q \
    && build_dir="$(mktemp -d /tmp/oncotracer-build.XXXXXXXX)" \
    && python -B scripts/build_native_binary.py --root /opt/oncotracer \
       --output "${build_dir}/oncotracer" --source-commit "${SOURCE_COMMIT}" --source-sha256 "${SOURCE_SHA256}" \
    && install -m 0755 "${build_dir}/oncotracer" /usr/local/bin/oncotracer \
    && rm "${build_dir}/oncotracer" && rmdir "${build_dir}" \
    && oncotracer --version \
    && oncotracer provenance --json \
    && nextflow -version

LABEL org.opencontainers.image.version="3.0.0" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.source.sha256="${SOURCE_SHA256}"

ENTRYPOINT ["oncotracer"]
CMD ["--help"]

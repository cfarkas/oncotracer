nextflow.enable.dsl = 2
manifest {
    name = 'pbmc-genome'
    version = '1.1.0'
    nextflowVersion = '>=24.10.0'
}
params {
    python = 'python3'
    matched_normal_bam = null
    matched_normal_sample = null
    bam = null
    germline_vcf = null
    somatic_vcf = null
    fastq = null
    annovar = false
    gwas = false
    output = null
    threads = 8
    memory = '32GB'
    sample = null
    library = 'lib1'
    single_end = false
    reference = null
    bwa_index = null
    tool_prefix = null
    clinvar = null
    annovar_dir = null
    annovar_db = null
    vep = false
    vep_path = null
    vep_cache = null
    vep_cache_version = null
    traits_panel = null
    gwas_catalog = null
    resource_dir = null
    no_ancestry = false
    ancestry_min_sites = 1000
    ancestry_explorer = true
    no_ancestry_explorer = null
    ancestry_explorer_manifest = null
    ancestry_explorer_cache = null
    germline_resource = null
    panel_of_normals = null
    contamination_sites = null
    regions = null
    min_depth = 10
    min_gq = 20
    min_mapping_quality = 30
    min_base_quality = 20
    test_reads = 0
    allow_test_reference = false
    preflight_only = false
    help = false
    glimpse2 = true
    reuse_from = null
    no_glimpse2 = null
    glimpse_reference_dir = null
    glimpse_bin = null
    glimpse_chromosomes = 'all'
    confidence_gwas = null
    trait_mode = 'exploratory'
    trait_min_depth = 2
    trait_min_gq = 5
    imputation_min_gp = 0.90
    imputation_min_info = 0.30
    imputed_clinvar = false
    no_imputed_clinvar = null
    polygenic = false
    pgs_manifest = null
    pgs_cache = null
    patients = null
    patient_database = null
    pgs_reference_stats = false
    no_pgs_reference_stats = null
    pgs_reference_population = 'auto'
    pgs_priority_focus = ''
    homozygosity_report = true
    no_homozygosity_report = null
    cancer_report = true
    no_cancer_report = null
    cardiomyopathy_report = true
    no_cardiomyopathy_report = null
    unified_vcf = true
    no_unified_vcf = null
    pgs_min_coverage = 0.75
    pgs_min_weight_coverage = 0.75
    explain_findings = true
    no_explain_findings = null
    explanation_evidence = null
    literature_cache = null
    literature_release = '2026-10'
    literature_offline = false
    interpretation_report = false
    no_interpretation_report = null
    report_llm = false
    gpu_usage = false
    no_report_llm = null
    report_pdf = true
    no_report_pdf = null
    llm_model = null
    llm_python = null
    llm_threads = 4
    llm_max_new_tokens = 512
    // Compatibility with configurations generated by version 1.0.
    manifest = null
    runtime = null
    memory_gb = null
    work_dir = null
    outdir = null
}
params.continue = false
// ConfigBuilder normalizes 'last' before creating the Nextflow session.
resume = params.continue.toString() == 'true' ? 'last' : null
// Native -work-dir overrides this default. With no --output, the task cache is
// work/ and Nextflow execution reports are in .nextflow/reports/ at launchDir.
workDir = params.work_dir ?: (params.output ? "${params.output}/work" : 'work')
process {
    // --continue supplies only provenance/structure-validated task outputs.
    // Never let Nextflow's existence-only cache resurrect a rejected task.
    cache = false
    executor = 'local'
    cpus = 1
    memory = '2 GB'
    errorStrategy = 'terminate'
    shell = ['/bin/bash', '-euo', 'pipefail']
    withLabel: imputation {
        cpus = Math.min(4, params.threads.toString().toInteger())
        memory = params.memory_gb != null ? "${Math.min(16.0, params.memory_gb as double)} GB" : "${Math.min(16, nextflow.util.MemoryUnit.of(params.memory.toString().trim() ==~ /[0-9]+(?:\.[0-9]+)?/ ? params.memory.toString()+'GB' : params.memory.toString().trim().replaceAll(/(?i)([GMT])I?B?$/, '$1B')).toGiga())} GB"
    }
    withName: PGS_REFERENCE_STATS {
        cpus = Math.min(16, params.threads.toString().toInteger())
    }
    withLabel: reference_download {
        cpus = 1
        memory = '2 GB'
        maxForks = 2
        // Keep in-flight downloads/imputation alive if both reference endpoints fail.
        // The workflow still exits unsuccessfully; --continue reuses completed tasks.
        errorStrategy = 'finish'
    }
    withLabel: pgs_download {
        cpus = 1
        memory = '2 GB'
        maxForks = 2
        errorStrategy = 'finish'
    }
    withLabel: heavy {
        cpus = params.threads.toString().toInteger()
        memory = params.memory_gb != null ? "${params.memory_gb} GB" : (params.memory.toString().trim() ==~ /[0-9]+(?:\.[0-9]+)?/ ? "${params.memory} GB" : params.memory.toString().trim().replaceAll(/(?i)([GMT])I?B?$/, '$1B'))
    }
}
executor {
    cpus = params.threads.toString().toInteger()
    memory = params.memory_gb != null ? "${params.memory_gb} GB" : (params.memory.toString().trim() ==~ /[0-9]+(?:\.[0-9]+)?/ ? "${params.memory} GB" : params.memory.toString().trim().replaceAll(/(?i)([GMT])I?B?$/, '$1B'))
    queueSize = params.threads.toString().toInteger()
}
env {
    PYTHONDONTWRITEBYTECODE = '1'
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
}
timeline {
    enabled = params.help.toString() != 'true' && params.preflight_only.toString() != 'true' && params.preflightOnly.toString() != 'true'
    file = params.output ? "${params.output}/pipeline_info/timeline-${System.currentTimeMillis()}.html" : "${launchDir}/.nextflow/reports/timeline.html"
    overwrite = true
}
report {
    enabled = params.help.toString() != 'true' && params.preflight_only.toString() != 'true' && params.preflightOnly.toString() != 'true'
    file = params.output ? "${params.output}/pipeline_info/execution-${System.currentTimeMillis()}.html" : "${launchDir}/.nextflow/reports/execution.html"
    overwrite = true
}
trace {
    enabled = params.help.toString() != 'true' && params.preflight_only.toString() != 'true' && params.preflightOnly.toString() != 'true'
    file = params.output ? "${params.output}/pipeline_info/trace-${System.currentTimeMillis()}.tsv" : "${launchDir}/.nextflow/reports/trace.tsv"
    overwrite = true
}
dag {
    enabled = params.help.toString() != 'true' && params.preflight_only.toString() != 'true' && params.preflightOnly.toString() != 'true'
    file = params.output ? "${params.output}/pipeline_info/dag-${System.currentTimeMillis()}.html" : "${launchDir}/.nextflow/reports/dag.html"
    overwrite = true
}

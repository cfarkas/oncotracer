          "start": 0.5247259298339486,
          "end": 3.2736045122146606,
          "title": "One named folder per ONT library",
          "text": "Each ONCO-style library has fastq_pass and pod5_pass. This demo restores three libraries from their saved ONT project."
        },
        {
          "start": 3.2736045122146606,
          "end": 10.306912487838417,
          "title": "Matching POD5 is selected",
          "text": "Each library keeps its own passed signal reads. Compatible Dorado and classifier models are required; these are synthetic fixtures."
        },
        {
          "start": 10.306912487838417,
          "end": 17.661656726151705,
          "title": "1 \u00b7 Drag samples",
          "text": "Synthetic example: ONCO-001 \u2192 MARLIN; ONCO-002 \u2192 Sturgeon. For real data use clinical records; never infer diagnosis from names."
        },
        {
          "start": 17.661656726151705,
          "end": 25.133468790911138,
          "title": "Unknown is separate from Cancer or Normal",
          "text": "Cancer/Normal records the clinical role. These columns only choose a CpG classifier. Return unsuitable samples to Unknown / do not classify."
        },
        {
          "start": 25.133468790911138,
          "end": 32.77733909105882,
          "title": "2 \u00b7 Save the chosen group",
          "text": "Choose MARLIN and save. Its new project contains only ONCO-001."
        },
        {
          "start": 32.77733909105882,
          "end": 36.070522440131754,
          "title": "2 \u00b7 Save the chosen group",
          "text": "Choose Sturgeon and save ONCO-002 separately. The other group and Unknown sample are excluded."
        },
        {
          "start": 36.070522440131754,
          "end": 44.00737115321681,
          "title": "Confirm your Sturgeon license",
          "text": "Only acknowledge this after obtaining Sturgeon and accepting its terms. This demonstration uses synthetic resources."
        },
        {
          "start": 44.00737115321681,
          "end": 48.43951623700559,
          "title": "3 \u00b7 Run only when ready",
          "text": "Use valid POD5 and compatible models, resolve checks and license requirements, then click Run explicitly. This demo stops after saving."
        }

manifest {
    name = 'OncoTracer'
    description = 'OncoTracer visual setup and complete GLIMPSE2 short-variant workflow'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.10.0'
}
params {
    interactive = false
    ffpe = false
    no_browser = false
    project = null
    input_folder = null
    image = null

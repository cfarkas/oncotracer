manifest {
    name = 'OncoTracer'
    version = '3.0.0'
    description = 'OncoTracer visual setup and complete GLIMPSE2 short-variant workflow'
    mainScript = 'main.nf'
    nextflowVersion = '>=24.10.0'
}
params {
    interactive = false
    gpu = false
    gpu_wait_hours = null
    cpu = false
    ffpe = false
    ont_named_samples = false
    no_browser = false
    project = null
    input_folder = null
    cpg_from = null
    classifier = null
    resources = null
    image = null
    variant_tool_prefix = null
    variant_ffperase_root = null
    variant_ffperase_models = null
    variant_ffperase_sif = null
    variant_ffperase_prefix = null
    analysis = 'variants'
    config = null
    port = null
    start_dir = null
    python = 'python3'
    backend = null
    threads = null
    parallel_samples = null
    // Null preserves explicit YAML choices; the controller defaults to compact.
    cna_profile = null
    storage_mode = null
    resource_mode = null
    merge_vcfs = null
    no_merge_vcfs = false
    dry_run = false
    help = false
}

    variant_ffperase_root = null
    variant_ffperase_models = null
    variant_ffperase_sif = null
    variant_ffperase_prefix = null
    analysis = 'variants'
    config = null
    port = 8888
    start_dir = null
    python = 'python3'
    backend = null
    threads = null
    parallel_samples = null
    dry_run = false
    help = false
}
